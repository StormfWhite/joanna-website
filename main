// ====== FULL AUDIOBOOK PAGE ======
function renderFullAudiobooksPage() {
  const container = document.getElementById('audiobookList');
  container.innerHTML = ''; // Clear previous content

  SITE.audiobooks.forEach(audio => {
    const card = document.createElement('div');
    card.className = 'card audio-item';

    card.innerHTML = `
      <div class="top">
        <img src="${audio.image || 'images/default-audio.jpg'}" alt="${audio.title}">
        <div class="info">
          <h3 class="audio-title">${audio.title}</h3>
          <div class="audio-length">${audio.length || ''}</div>
        </div>
      </div>

      <div class="audio-player">
        <audio controls preload="none">
          <source src="${audio.src}" type="audio/mpeg">
          Your browser does not support the audio element.
        </audio>
      </div>

      <div class="download-wrap">
        <a class="btn ghost download" href="${audio.src}" download>Download</a>
      </div>
    `;

    container.appendChild(card);
  });
}
    // Full courses page
    function renderCoursesFull(){
      const grid = $('#courseFull'); grid.innerHTML='';
      SITE.courses.forEach(c => grid.appendChild(courseCard(c,false)));
    }

    function courseCard(c, compact){
      const card = el('div','card');
      card.innerHTML = `<h3 style="margin-top:0">${c.title}</h3><div class="price">${money(c.price)}</div>`;
      const ul = el('ul',''); ul.style.marginTop = '8px'; ul.style.paddingLeft = '18px';
      c.details.forEach(d => { const li = el('li','', d); ul.appendChild(li); });
      const btn = el('a','btn primary','Sign Up'); btn.href = c.checkout; btn.target = '_blank'; btn.rel = 'noopener'; btn.style.marginTop='10px';
      card.appendChild(ul); card.appendChild(btn);
      if(compact) card.style.paddingBottom = '12px';
      return card;
    }

// ====== BLOG PAGE FUNCTION ======
function renderFullBlogPage() {
  const container = document.getElementById('blogList');
  container.innerHTML = ''; // clear existing content

  // Sort blogs chronologically: earliest first
  const sortedBlogs = SITE.blogs.slice().sort((a, b) => new Date(a.date) - new Date(b.date));

  sortedBlogs.forEach(blog => {
    const article = document.createElement('div');
    article.classList.add('blog-strip');
    article.innerHTML = `
      <h2><a href="#/blogs?id=${blog.id}">${blog.title}</a></h2>
      <p class="summary">${blog.excerpt}</p>
      <span class="date">${new Date(blog.date).toLocaleDateString()}</span>
    `;
    container.appendChild(article);
  });
}

function showBlogArticle(id){
  const art = SITE.blogs.find(b => String(b.id) === String(id));
  const article = $('#blogArticle');
  if(!art){ article.style.display='none'; return; }
  article.style.display = 'block';
  article.innerHTML = `
    <h2 style="margin-top:0">${art.title}</h2>
    <div class="sub" style="margin-bottom:10px">${new Date(art.date).toLocaleDateString()}</div>
    ${art.html}
    <p style='margin-top:14px'><a class="btn" href="#/blogs">Back to list</a></p>
  `;
  window.scrollTo({top:0, behavior:'smooth'});
}


    // CONTACT (dummy — replace with real endpoint/service like Formspree)
    function sendEmail(e){
      e.preventDefault();
      const form = e.target; const data = Object.fromEntries(new FormData(form).entries());
      document.getElementById('contactStatus').textContent = 'Thanks! I\'ll get back to you shortly.';
      form.reset();
      // TIP: To make this functional without a backend, connect to Formspree or Basin:
      // 1) Create a Formspree form, get the endpoint URL
      // 2) Replace this handler with fetch('FORM_ENDPOINT', {method:'POST', body: new FormData(form) })
    }

    // Simple hash router
    function route(){
      const hash = location.hash || '#/';
      $$('.page').forEach(p => p.classList.remove('active'));
if(hash.startsWith('#/blogs')){
  $('#blogs').classList.add('active');
  const qs = new URLSearchParams(hash.split('?')[1]);
  if(qs.get('id')){
    showBlogArticle(qs.get('id'));
  } else {
    renderFullBlogPage();
  }
}

      else if(hash === '#/courses'){ $('#courses').classList.add('active'); renderCoursesFull(); }
      else if(hash === '#/audiobooks'){
  $('#audiobooksPage').classList.add('active');
  renderFullAudiobooksPage();
}
      else if(hash === '#/contact'){ $('#contact').classList.add('active'); }
      else { $('#home').classList.add('active'); }
    }

    // ====== INIT ======
    function init(){
      document.getElementById('year').textContent = new Date().getFullYear();
      document.getElementById('brandName').textContent = SITE.brandName;
      document.getElementById('footerName').textContent = SITE.teacherName;
      document.getElementById('teacherName').textContent = SITE.teacherName;
      document.getElementById('heroImage').src = SITE.heroImage;

      renderBlogHeads();
      renderAudiobooks();
      renderVideos();
      renderCoursePreview();
      route();
      window.addEventListener('hashchange', route);
    }

    init();
  </script>
