    // ====== RENDER HELPERS ======
    const $ = (sel) => document.querySelector(sel);
    const $$ = (sel) => document.querySelectorAll(sel);

    function money(n){ return new Intl.NumberFormat(undefined,{style:'currency',currency:'USD'}).format(n); }

    function el(tag, cls, html){ const e = document.createElement(tag); if(cls) e.className = cls; if(html!==undefined) e.innerHTML = html; return e; }

    // BLOG PREVIEW (headings only)
    function renderBlogHeads(){
      const wrap = $('#blogHeads');
      wrap.innerHTML = '';
      SITE.blogs.slice(0,3).forEach(b => {
        const card = el('div','card blog-item');
        card.innerHTML = `<h3>${b.title}</h3><div class="meta">${new Date(b.date).toLocaleDateString()}</div><div class="sub">${b.excerpt}</div>`;
        card.addEventListener('click', () => { location.hash = `#/blogs?id=${b.id}`; });
        wrap.appendChild(card);
      });
    }

    // AUDIOBOOKS
    function renderAudiobooks(){
      const wrap = $('#audioCards');
      wrap.innerHTML = '';
      SITE.audiobooks.forEach(a => {
        const card = el('div','card audio-item');
        card.innerHTML = `<h3>${a.title}</h3><div class="sub">${a.blurb}</div><audio controls preload="none"><source src="${a.src}" type="audio/mpeg">Your browser does not support the audio element.</audio>`;
        wrap.appendChild(card);
      });
    }

    // VIDEOS
    function renderVideos(){
      const row = $('#videoRow'); row.innerHTML='';
      SITE.youtubeVideoIds.slice(0,3).forEach(id => {
        const card = el('div','card');
        const box = el('div','video');
        box.innerHTML = `<iframe src="https://www.youtube.com/embed/${id}" title="YouTube video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
        card.appendChild(box); row.appendChild(card);
      });
      const link = $('#ytLink'); link.href = SITE.youtubeChannelUrl; link.textContent = 'Go to my channel';
    }

    // COURSE PREVIEW (3 cards)
    function renderCoursePreview(){
      const grid = $('#coursePreview'); grid.innerHTML='';
      SITE.courses.forEach(c => grid.appendChild(courseCard(c,true)));
    }
